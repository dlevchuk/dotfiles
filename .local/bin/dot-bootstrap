#!/bin/bash
set -euo pipefail
# Run from a normal clone: bash .local/bin/dot-bootstrap [--with-apps]
source_root="$(cd "$(dirname "$0")/../.." && pwd)"
[[ "$source_root" != "$HOME" ]] || { echo 'Run bootstrap from a separate clone.' >&2; exit 1; }
repo="$HOME/.dotfiles"
[[ ! -e "$repo" ]] || { echo '~/.dotfiles already exists; refusing to replace it.' >&2; exit 1; }
backup="$HOME/.local/state/dotfiles/backups/$(date +%Y%m%d-%H%M%S)-$$"
mkdir -p "$backup"
git clone --bare "$source_root" "$repo"
git --git-dir="$repo" remote set-url origin "$(git -C "$source_root" remote get-url origin)"
dot() { git -c core.fsmonitor=false --git-dir="$repo" --work-tree="$HOME" -C "$HOME" "$@"; }
# Back up each conflicting tracked path, preserving its relative location.
while IFS= read -r -d '' file; do
  if [[ -e "$HOME/$file" || -L "$HOME/$file" ]]; then
    mkdir -p "$backup/$(dirname "$file")"
    cp -pPR "$HOME/$file" "$backup/$file"
  fi
done < <(dot ls-tree -rz --name-only HEAD)
dot checkout -f
dot config status.showUntrackedFiles no
dot config core.fsmonitor false
dot config core.excludesFile "$HOME/.config/dotfiles/gitignore"
if [[ "${1:-}" == --with-apps ]]; then
  command -v brew >/dev/null || { echo 'Install Homebrew, then run brew bundle.' >&2; exit 1; }
  brew bundle --file="$HOME/.config/dotfiles/Brewfile"
fi
if [[ ! -d "$HOME/.oh-my-zsh" ]]; then
  git clone --depth=1 https://github.com/ohmyzsh/ohmyzsh.git "$HOME/.oh-my-zsh"
fi
"$HOME/.local/bin/dot-check"
"$HOME/.local/bin/dot-install-agent"
echo "Restored dotfiles. Backup: $backup"
