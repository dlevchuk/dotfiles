#!/bin/bash
set -euo pipefail
[[ "$(uname -s)" == Darwin ]] || { echo 'launchd requires macOS.' >&2; exit 1; }
label=com.user.dotfiles-sync
agent="$HOME/Library/LaunchAgents/$label.plist"
state="$HOME/.local/state/dotfiles"
mkdir -p "$HOME/Library/LaunchAgents" "$state"
# Generate machine-specific paths locally; no hardcoded username in Git.
rm -f "$state/agent.plist"
/usr/bin/plutil -create xml1 "$state/agent.plist"
/usr/bin/plutil -insert Label -string "$label" "$state/agent.plist"
/usr/bin/plutil -insert ProgramArguments -json "[\"$HOME/.local/bin/dot-save\",\"--auto\"]" "$state/agent.plist"
/usr/bin/plutil -insert StartInterval -integer 1800 "$state/agent.plist"
/usr/bin/plutil -insert RunAtLoad -bool YES "$state/agent.plist"
/usr/bin/plutil -insert StandardOutPath -string "$state/sync.log" "$state/agent.plist"
/usr/bin/plutil -insert StandardErrorPath -string "$state/sync.err" "$state/agent.plist"
/usr/bin/plutil -lint "$state/agent.plist"
launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
cp "$state/agent.plist" "$agent"
launchctl bootstrap "gui/$(id -u)" "$agent"
echo 'Auto commit/push enabled every 30 minutes.'
