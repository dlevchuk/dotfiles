cask "firefox"
# Terminal emulator that uses platform-native UI and GPU acceleration
cask "ghostty"
# Desktop client for GitHub repositories
cask "github"
# Game client
cask "gog-galaxy"
# Web browser
cask "google-chrome"
# Homebrew's official GUI
cask "homebrew-app"
